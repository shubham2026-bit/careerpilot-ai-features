# CareerPilot AI - Environment Variables Template
# Copy this to .env.development.local and fill in your values

# ===== SUPABASE =====
NEXT_PUBLIC_SUPABASE_URL=https://njoghcklnnskzlxklfrx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ===== AUTHENTICATION =====
BETTER_AUTH_SECRET=your_generated_secret_here
# Generate with: openssl rand -base64 32

# ===== BREVO EMAIL SERVICE =====
BREVO_API_KEY=your_brevo_api_key_here

# ===== AI & LLM =====
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_key_here

# ===== OAUTH =====
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
LINKEDIN_OAUTH_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_OAUTH_CLIENT_SECRET=your_linkedin_client_secret_here

# ===== APPLICATION =====
NEXT_PUBLIC_APP_URL=https://v0-careerpilot.vercel.app

# ===== CRON JOBS =====
CRON_SECRET=your_cron_secret_here

# ===== OPTIONAL =====
# Job API Keys (when integrating real job data)
INDEED_API_KEY=optional
REMOTEOK_API_KEY=optional
LINKEDIN_API_KEY=optional

# Analytics
NEXT_PUBLIC_GA_ID=optional

# Feature Flags
FEATURE_AI_COACHING=true
FEATURE_JOB_SEARCH=true
FEATURE_PORTFOLIO_ANALYSIS=true
FEATURE_OAUTH=false  # Set to true once OAuth is configured
